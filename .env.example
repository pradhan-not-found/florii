# Public site address, used for canonical URLs, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://floriii.vercel.app

# GitHub repository: enables the star count and the GitHub links in the footer.
NEXT_PUBLIC_GITHUB_URL=https://github.com/pradhan-not-found/florii

# Razorpay (sponsor checkout). Keys from Dashboard > Account & Settings > API Keys.
# Keep RAZORPAY_KEY_SECRET private: never prefix it with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional extras.
NEXT_PUBLIC_VISITOR_COUNTER_URL=
NEXT_PUBLIC_COFFEE_URL=
NEXT_PUBLIC_X_URL=

{
  "name": "florii",
  "version": "0.1.2",
  "description": "36 hand-painted flower and leaf SVG components for React, with seven decorations and gentle CSS animations. Typed, tree-shakeable, no dependencies.",
  "author": "pradhan-not-found",
  "homepage": "https://floriii.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pradhan-not-found/florii.git",
    "directory": "packages/florii"
  },
  "bugs": {
    "url": "https://github.com/pradhan-not-found/florii/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://floriii.vercel.app/#sponsors"
  },
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "node build.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "react",
    "react-components",
    "flowers",
    "botanical",
    "floral",
    "svg",
    "svg-icons",
    "illustrations",
    "decorations",
    "animation",
    "css-animation",
    "nextjs",
    "typescript",
    "ui",
    "design"
  ],
  "engines": {
    "node": ">=18"
  }
}
